# Privora static hosting rules (Apache). Shipped inside dist/.
# Every page is a real file (/tool-slug/index.html), so no rewrites are needed.
# Security headers, CSP and COOP/COEP are added in Phase 09.

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change, so cache them for a year.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|mjs|css|woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # pdf.js data files (fonts, CMaps, colour profiles, decoders) keep fixed
  # names and change only with a pdfjs-dist upgrade: cache for a week.
  <If "%{REQUEST_URI} =~ m#^/vendor/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  # Always revalidate pages so new deploys show up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
